# Environments, caches, OS / editor junk
.venv/
venv/
__pycache__/
*.pyc
.DS_Store
~$*
ci-logs/

# Large or personal binaries
*.pdf
*.xlsx

# Datasets (prepared locally by experiments/ros2/prepare_coco128.sh)
data/raw/images/*
!data/raw/images/.gitkeep
data/raw/coco128.zip

# Results tracking policy (results/README.md):
#   results/raw/ros2/   raw ROS 2 measurements (<run_id>.csv, .publisher.csv, .meta.json): tracked,
#                       they are the evidence the provenance chain hashes. Failed runs stay local.
#   results/csv/        derived CSVs + .provenance.json sidecars + .manifest.json: tracked together;
#                       every file is regenerated by a documented command.
#   results/figures/    SVGs generated by scripts: tracked.
# Stray CSVs anywhere else stay ignored.
*.csv
!results/raw/ros2/*.csv
!results/csv/*.csv
results/raw/ros2/*.failed
# Phase 3 / Batch 1 pilot (short interleaved scheduling runs): tracked like raw/ros2, kept
# apart so the verified Phase 2 baseline chain (raw/ros2 -> runtime summary) is untouched.
!results/raw/ros2_phase3_pilot/*.csv
results/raw/ros2_phase3_pilot/*.failed
# Phase 3 / Batch 2 formal A/B benchmark: tracked; verified by scripts/check_phase3_provenance.py.
!results/raw/ros2_phase3_formal/*.csv
results/raw/ros2_phase3_formal/*.failed
