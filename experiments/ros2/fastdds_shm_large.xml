<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast DDS profile for same-host ROS 2 runs of src/ros2_uav_pipeline (Phase 2 / Batch 1).

  Why: the publisher sends 640x(218..640) bgr8 COCO128 frames (about 0.4-1.2 MB each) and the
  detector subscribes BEST_EFFORT. On the Phase 2 server (net.core.rmem_max = rmem_default =
  212992) the RMW default transports lost 50-85% of frames at 5 FPS (Fast DDS default
  UDPv4 + 512 KB SHM segment), and CycloneDDS over UDP lost ~99% with kernel UDP RcvbufErrors.
  This profile uses only the shared-memory transport with a 16 MB segment: one host, no
  network traffic, no sudo / sysctl change. See report/PHASE2_BATCH1_RESULT.md.

  Use (process-local, recorded with its SHA-256 in <run_id>.meta.json -> dds_profile):
    export FASTRTPS_DEFAULT_PROFILES_FILE="$PWD/experiments/ros2/fastdds_shm_large.xml"
  Requires the default RMW (rmw_fastrtps_cpp). Publisher and detector must run on one host.
-->
<profiles xmlns="http://www.eprosima.com/xml/schemas/fastdds-profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_large</transport_id>
      <type>SHM</type>
      <segment_size>16777216</segment_size>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="shm_large_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>shm_large</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
